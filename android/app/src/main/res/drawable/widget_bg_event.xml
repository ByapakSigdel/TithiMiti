<?xml version="1.0" encoding="utf-8"?>
<!-- Dark rounded card for the custom-event widget. Matches widget_bg_metals but
     with a subtle brand-red edge instead of gold, so the two small widgets read
     as a matching set. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:startColor="#FF0A0A0F"
        android:centerColor="#FF101016"
        android:endColor="#FF15141A"
        android:angle="135" />
    <corners android:radius="22dp" />
    <stroke android:width="1dp" android:color="#44D71921" />
</shape>
