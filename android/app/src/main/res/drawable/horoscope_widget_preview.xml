<?xml version="1.0" encoding="utf-8"?>
<!-- Picker thumbnail for launchers that can't render previewLayout (pre-12):
     the painting page of the widget — airy mood gradient with the zodiac
     scrim pill bottom-left. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Painting placeholder (airy mood gradient) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#FF3A4C73"
                android:centerColor="#FF7E78A8"
                android:endColor="#FFD9C28E" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.35"
                android:centerY="0.2"
                android:gradientRadius="85%"
                android:startColor="#80FFFFFF"
                android:endColor="#00000000" />
            <corners android:radius="24dp" />
        </shape>
    </item>

    <!-- Warm scrim zodiac pill, bottom-left -->
    <item android:left="12dp" android:right="88dp" android:top="122dp" android:bottom="12dp">
        <shape android:shape="rectangle">
            <solid android:color="#99170E08" />
            <corners android:radius="999dp" />
        </shape>
    </item>

</layer-list>
