<?xml version="1.0" encoding="utf-8"?>
<!-- The widget card: warm paper fill with a 1dp sand hairline (DesignLanguage
     §5). Radius 24dp — launchers on Android 12+ may clip tighter to match the
     system radius, which is fine. Theme-aware via widget color tokens. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/widget_card" />
    <corners android:radius="24dp" />
    <stroke android:width="1dp" android:color="@color/widget_border" />
</shape>
