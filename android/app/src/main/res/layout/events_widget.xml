<?xml version="1.0" encoding="utf-8"?>
<!-- Next-event widget: card row in the Hundred Studios language. Date box on
     the left (Fraunces numeral + month caption; soft teal when the event is
     today; a teal "+" when there's nothing upcoming), teal NEXT EVENT kicker,
     title, and a friendly date line. Teal is the user-content hue (§2.3).
     The three date-box variants are toggled by visibility so all colors stay
     in XML and survive a system theme flip. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingLeft="14dp"
    android:paddingRight="14dp"
    android:paddingTop="9dp"
    android:paddingBottom="9dp">

    <FrameLayout
        android:layout_width="46dp"
        android:layout_height="46dp">

        <LinearLayout
            android:id="@+id/date_box"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_datebox_bg"
            android:visibility="gone">

            <!-- Fraunces numeral, drawn in-process (see WidgetText) and tinted
                 so the launcher renders the real serif in both themes. -->
            <ImageView
                android:id="@+id/event_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tint="@color/widget_text"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/event_month"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="JAN"
                android:textSize="8sp"
                android:textColor="@color/widget_text_secondary"
                android:fontFamily="sans-serif-medium"
                android:textAllCaps="true"
                android:letterSpacing="0.12"
                android:includeFontPadding="false"
                android:maxLines="1" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/date_box_today"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_datebox_today_bg"
            android:visibility="gone">

            <ImageView
                android:id="@+id/event_day_today"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tint="@color/widget_teal"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/event_month_today"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="JAN"
                android:textSize="8sp"
                android:textColor="@color/widget_teal"
                android:fontFamily="sans-serif-medium"
                android:textAllCaps="true"
                android:letterSpacing="0.12"
                android:includeFontPadding="false"
                android:maxLines="1" />
        </LinearLayout>

        <TextView
            android:id="@+id/date_box_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:background="@drawable/widget_datebox_today_bg"
            android:text="+"
            android:textSize="21sp"
            android:textColor="@color/widget_teal"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:visibility="visible" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/widget_tick_teal"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/events_kicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NEXT EVENT"
                android:textSize="9sp"
                android:textColor="@color/widget_teal"
                android:fontFamily="sans-serif-medium"
                android:textAllCaps="true"
                android:letterSpacing="0.13"
                android:maxLines="1" />
        </LinearLayout>

        <TextView
            android:id="@+id/next_event_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="No upcoming events"
            android:textSize="14sp"
            android:textColor="@color/widget_text"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/next_event_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="Tap to add one"
            android:textSize="10.5sp"
            android:textColor="@color/widget_text_secondary"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

</LinearLayout>
