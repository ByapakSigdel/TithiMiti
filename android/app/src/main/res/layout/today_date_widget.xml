<?xml version="1.0" encoding="utf-8"?>
<!-- Today's date widget (dark card, matches the metals/event widgets). Hero BS
     date, with weekday pill + AD date, tithi, sunrise/sunset and today's event. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_event"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Top row: weekday pill + AD date -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/weekday_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TODAY"
            android:textSize="9sp"
            android:textColor="#FFFFFFFF"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:letterSpacing="0.06"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:background="@drawable/widget_pill_red" />

        <TextView
            android:id="@+id/ad_date_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="—"
            android:textSize="11sp"
            android:textColor="#FF9AA0A8" />
    </LinearLayout>

    <!-- Hero BS Date -->
    <TextView
        android:id="@+id/bs_date_large"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="—"
        android:textSize="26sp"
        android:textColor="#FFF2F2F4"
        android:textStyle="bold"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/bs_date_nepali"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="11sp"
        android:textColor="#FF9AA0A8" />

    <!-- Tithi -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="7dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="•"
            android:textSize="12sp"
            android:textColor="#FFE2606C"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/tithi_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textSize="12sp"
            android:textColor="#FFE6E6EA" />
    </LinearLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#22FFFFFF"
        android:contentDescription="@null"
        android:layout_marginTop="9dp"
        android:layout_marginBottom="9dp" />

    <!-- Sunrise / Sunset row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☀"
            android:textSize="13sp"
            android:textColor="#FFE9C46A"
            android:layout_marginEnd="5dp" />

        <TextView
            android:id="@+id/sunrise_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="--:--"
            android:textSize="12sp"
            android:textColor="#FFF2F2F4"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☾"
            android:textSize="13sp"
            android:textColor="#FFC8CCD0"
            android:layout_marginEnd="5dp" />

        <TextView
            android:id="@+id/sunset_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--:--"
            android:textSize="12sp"
            android:textColor="#FFF2F2F4"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Today's event (single line) -->
    <TextView
        android:id="@+id/today_event_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No event today"
        android:textSize="11sp"
        android:textColor="#FF9AA0A8"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginTop="9dp" />

</LinearLayout>
