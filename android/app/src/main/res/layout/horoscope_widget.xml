<?xml version="1.0" encoding="utf-8"?>
<!-- Two-page horoscope widget. Tapping the widget flips between the painting
     page and the written-reading page (instant, no animation, no scrolling).
     Exactly one page is visible at a time; the provider toggles visibility. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0E0E12">

    <!-- Page 1: the mood painting, on its own. -->
    <FrameLayout
        android:id="@+id/painting_page"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible">

        <ImageView
            android:id="@+id/painting_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null"
            android:src="@drawable/horoscope_art_airy" />
    </FrameLayout>

    <!-- Page 2: the written reading, on its own paper page (no painting behind). -->
    <LinearLayout
        android:id="@+id/text_page"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/horoscope_page_bg"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/zodiac_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="MESH · DAILY"
            android:textColor="#FFB81620"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:letterSpacing="0.16" />

        <TextView
            android:id="@+id/horoscope_text"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Open Tools to load your horoscope"
            android:textColor="#FF24201A"
            android:fontFamily="@font/fraunces"
            android:lineSpacingExtra="3dp"
            android:ellipsize="end"
            android:maxLines="8"
            android:textSize="14sp"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="11sp"
            android:autoSizeMaxTextSize="24sp"
            android:autoSizeStepGranularity="1sp" />
    </LinearLayout>

</FrameLayout>
